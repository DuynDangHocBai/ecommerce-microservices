# API Gateway (sẽ publish ra host port 18080)
GATEWAY_PORT=18080

# Auth Database (PostgreSQL)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_PORT=15433

# Customer Database (PostgreSQL)
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=customer_password
CUSTOMER_DB_PORT=15434

# Order Database (PostgreSQL)
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password
ORDER_DB_PORT=15435

# Product Database (MongoDB)
PRODUCT_DB_NAME=product_db
PRODUCT_DB_PORT=37018

# Shipment Database (MongoDB)
SHIPMENT_DB_NAME=shipment_db
SHIPMENT_DB_PORT=37019

# Redis
REDIS_PORT=16379

# Kafka
KAFKA_HOST_PORT=19092
